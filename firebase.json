{
  "hosting": {
    "public": "public",
    "ignore": ["firebase.json", "**/.*"],
    "cleanUrls": false,
    "trailingSlash": false,
    "headers": [
      {
        "source": "**/*.@(webp|png|jpg|jpeg|svg|ico)",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000" }]
      },
      {
        "source": "**/*.@(css|js)",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }]
      },
      {
        "source": "**/*.html",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      }
    ]
  }
}
