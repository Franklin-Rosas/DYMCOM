# Copia este archivo como .env.local y completa los valores.
# En GitHub van en Settings → Secrets and variables → Actions → pestaña "Variables".
# La configuración web de Firebase es pública por diseño (no es una contraseña),
# pero igual no se sube al repositorio.
NEXT_PUBLIC_SITE_URL=https://dymcom-98c14.web.app
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=dymcom-98c14.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=dymcom-98c14
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_RECAPTCHA_V3_SITE_KEY=
# Google Analytics 4 (ej. G-XXXXXXX). Vacío = no se carga Analytics ni el aviso de cookies.
NEXT_PUBLIC_GA_ID=
